{
  "name": "@mmbridge/dispatch",
  "version": "0.7.3",
  "description": "Role-routed dispatch for mmbridge — resolves a role to an authenticated model and runs it as an omp RPC worker",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
